# ==========================================
# БАЗА ДАННЫХ (PostgreSQL 16 + Prisma)
# ==========================================
DATABASE_URL="postgresql://dotahub:dotahub_local_pass@localhost:5432/dotahub?schema=public"

# ==========================================
# КОНФИГУРАЦИЯ СЕРВЕРА API (apps/api)
# ==========================================
NODE_ENV="development"
API_PORT=4000
API_HOST="0.0.0.0"
WEB_ORIGIN="http://localhost:5173"

# ==========================================
# БЕЗОПАСНОСТЬ И АВТОРИЗАЦИЯ
# В production обязательно замените на криптографически стойкие строки (минимум 32 символа)
# ==========================================
SESSION_SECRET="dev_only_session_secret_change_me_in_production_32chars"
CSRF_SECRET="dev_only_csrf_secret_change_me_in_production_32chars_min"
COOKIE_NAME="dotahub_sid"
COOKIE_SECURE="false"
SESSION_TTL_DAYS=14

# ==========================================
# ИГРОВАЯ ЭКОНОМИКА И ДЕМОРЕЖИМ
# Все денежные значения указываются в минимальных единицах (копейках: 100 = 1.00 ₽)
# ==========================================
DEMO_MODE_ENABLED="true"
INITIAL_DEMO_BALANCE_MINOR=250000
DAILY_BONUS_AMOUNT_MINOR=15000
UPGRADER_HOUSE_EDGE_PERCENT=5
UPGRADER_MIN_CHANCE_PERCENT=1
UPGRADER_MAX_CHANCE_PERCENT=85

# ==========================================
# ВНЕШНИЕ ИНТЕГРАЦИИ (ПО УМОЛЧАНИЮ ОТКЛЮЧЕНЫ)
# Включайте только после получения реальных ключей и юридической проверки
# ==========================================
STEAM_AUTH_ENABLED="false"
STEAM_API_KEY=""
STEAM_REALM="http://localhost:4000"
STEAM_RETURN_URL="http://localhost:4000/api/auth/steam/return"

REAL_PAYMENTS_ENABLED="false"
PAYMENT_WEBHOOK_SECRET=""

# ==========================================
# FRONTEND (apps/web)
# ==========================================
VITE_API_BASE_URL="http://localhost:4000/api"